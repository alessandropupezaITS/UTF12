<Page
    x:Class="ProgettoUSF12.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12"
    xmlns:frontend="using:ProgettoUSF12.FrontEnd"
    xmlns:classi="using:ProgettoUSF12.BackEnd.Classi"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Oro "Star Wars" usato per titoli e accenti -->
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#80FFE81F"/>

        <!-- Vetro liquido: sfoca lo sfondo dietro i pannelli -->
        <AcrylicBrush x:Key="VetroPannello"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.25"
                      FallbackColor="#141414"/>

        <AcrylicBrush x:Key="VetroTile"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.20"
                      FallbackColor="#1F1F1F"/>
    </Page.Resources>

    <Grid>
        <!-- Sfondo stellato a tutta pagina -->
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/sfondoHome.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superiore, comune a tutte le pagine -->
        <frontend:BarraSuperiore Grid.Row="0"/>

        <!-- Titolo della pagina -->
        <TextBlock Grid.Row="1"
                   Text="HOME"
                   FontSize="44"
                   FontWeight="Black"
                   CharacterSpacing="40"
                   Foreground="{StaticResource OroSW}"
                   Margin="32,24,0,16"/>

        <!-- Contenuto principale: pannello film + pannello attività -->
        <Grid Grid.Row="2" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Pannello Film, vetro liquido -->
            <Border Grid.Column="0"
                    Background="{StaticResource VetroPannello}"
                    BorderBrush="{StaticResource OroSWTenue}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="FILM"
                               Foreground="{StaticResource OroSW}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               CharacterSpacing="20"
                               Margin="0,0,0,16"/>

                    <!-- NUOVO: chip categorie (stessi di PaginaFilm). Filtrano la griglia qui sotto. -->
                    <ListView x:Name="ListaCategorie"
                              Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ListaCategorie_ItemClick"
                              Background="Transparent"
                              Margin="0,0,0,16">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{StaticResource VetroTile}"
                                        BorderBrush="{StaticResource OroSWTenue}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16,8"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{x:Bind}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Sezioni per trilogia: titolo + griglia di 3 locandine per riga.
                         Le dimensioni delle celle sono calcolate in GrigliaSezione_SizeChanged. -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="ListaSezioni">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SezioneFilm">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{x:Bind Titolo}"
                                                       Foreground="{StaticResource OroSW}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,8"/>
                                            <GridView ItemsSource="{x:Bind Films}"
                                                      SelectionMode="None"
                                                      IsItemClickEnabled="True"
                                                      ItemClick="ListaFilm_ItemClick"
                                                      SizeChanged="GrigliaSezione_SizeChanged"
                                                      ScrollViewer.VerticalScrollMode="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                      Background="Transparent">
                                                <GridView.ItemContainerStyle>
                                                    <Style TargetType="GridViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                    </Style>
                                                </GridView.ItemContainerStyle>
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="classi:Film">
                                                        <Border Background="{StaticResource VetroTile}"
                                                                BorderBrush="{StaticResource OroSWTenue}"
                                                                BorderThickness="1"
                                                                CornerRadius="16"
                                                                Margin="0,0,12,12">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Image Grid.Row="0"
                                                                       Source="{x:Bind local:MainPage.ConvertiPoster(PosterUrl)}"
                                                                       Stretch="UniformToFill"/>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{x:Bind Title}"
                                                                           Foreground="White"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Center"
                                                                           Margin="6,6,6,8"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NessunRisultato"
                                       Text="Nessun film trovato"
                                       Foreground="#B0B0B0"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       Margin="0,32,0,0"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Pannello attività recenti -->
            <Border Grid.Column="2"
                    Background="{StaticResource VetroPannello}"
                    BorderBrush="{StaticResource OroSWTenue}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="ULTIME ATTIVITÀ"
                               Foreground="{StaticResource OroSW}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               CharacterSpacing="20"
                               Margin="0,0,0,12"/>

                    <ListView x:Name="ListaAttivita"
                              Grid.Row="1"
                              SelectionMode="None"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="classi:AttivitaRecente">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{x:Bind Descrizione}" Foreground="White"/>
                                    <TextBlock Text="{x:Bind Data}" Foreground="#B0B0B0" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
