<Page
    x:Class="ProgettoUSF12.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12"
    xmlns:frontend="using:ProgettoUSF12.FrontEnd"
    xmlns:classi="using:ProgettoUSF12.BackEnd.Classi"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Oro "Star Wars" usato per titoli e accenti -->
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#80FFE81F"/>

        <!-- Vetro liquido: sfoca lo sfondo dietro i pannelli -->
        <AcrylicBrush x:Key="VetroPannello"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.25"
                      FallbackColor="#141414"/>

        <AcrylicBrush x:Key="VetroTile"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.20"
                      FallbackColor="#1F1F1F"/>
    </Page.Resources>

    <Grid>
        <!-- Sfondo stellato a tutta pagina -->
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/sfondoHome.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superiore, comune a tutte le pagine -->
        <frontend:BarraSuperiore Grid.Row="0"/>

        <!-- Titolo della pagina -->
        <TextBlock Grid.Row="1"
                   Text="HOME"
                   FontSize="44"
                   FontWeight="Black"
                   CharacterSpacing="40"
                   Foreground="{StaticResource OroSW}"
                   Margin="32,24,0,16"/>

        <!-- Contenuto principale: pannello film + pannello attività -->
        <Grid Grid.Row="2" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Pannello Film, vetro liquido -->
            <Border Grid.Column="0"
                    Background="{StaticResource VetroPannello}"
                    BorderBrush="{StaticResource OroSWTenue}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="FILM"
                               Foreground="{StaticResource OroSW}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               CharacterSpacing="20"
                               Margin="0,0,0,16"/>

                    <!-- Griglia film: solo locandina + titolo, cliccabili -->
                    <GridView x:Name="ListaFilm"
                              Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ListaFilm_ItemClick"
                              Background="Transparent">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="classi:Film">
                                <Border Background="{StaticResource VetroTile}"
                                        BorderBrush="{StaticResource OroSWTenue}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Width="130"
                                        Margin="0,0,12,12">
                                    <StackPanel>
                                        <!--<Image Source="{x:Bind PosterUrl}"
                                               Height="170"
                                               Stretch="UniformToFill"/>
                                         -->
                                        
                                        <TextBlock Text="{x:Bind Title}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="6,6,6,8"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </Border>

            <!-- Pannello attività recenti -->
            <Border Grid.Column="2"
                    Background="{StaticResource VetroPannello}"
                    BorderBrush="{StaticResource OroSWTenue}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="ULTIME ATTIVITÀ"
                               Foreground="{StaticResource OroSW}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               CharacterSpacing="20"
                               Margin="0,0,0,12"/>

                    <ListView x:Name="ListaAttivita"
                              Grid.Row="1"
                              SelectionMode="None"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="classi:AttivitaRecente">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{x:Bind Descrizione}" Foreground="White"/>
                                    <TextBlock Text="{x:Bind Data}" Foreground="#B0B0B0" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
