<UserControl
    x:Class="ProgettoUSF12.FrontEnd.BarraSuperiore"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12.FrontEnd"
    xmlns:services="using:ProgettoUSF12.BackEnd.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Colori generali -->
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#40FFE81F"/>
        <SolidColorBrush x:Key="RossoLogout" Color="#FF6B6B"/>
        <AcrylicBrush x:Key="VetroBarra"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.25"
                      FallbackColor="#1F1F1F"/>

        <!-- Risorse per la barra di ricerca -->
        <SolidColorBrush x:Key="OroSWBordo" Color="#80FFE81F"/>
        <AcrylicBrush x:Key="VetroTile"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.20"
                      FallbackColor="#1F1F1F"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource VetroBarra}" Height="72">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- SINISTRA: Tasto Home + Separatore + Pulsanti Film e Archivio -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0">

            <Button x:Name="HomeButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Margin="0,0,16,0"
                    Click="BtnHome_Click"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80F;" FontSize="24" Foreground="{StaticResource OroSW}"/>
            </Button>

            <Rectangle Width="1"
                       Height="36"
                       Fill="{StaticResource OroSWTenue}"
                       Margin="8,0,0,0"/>

            <Button Content="FILM"
                    Click="BtnFilm_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource OroSW}"
                    FontWeight="SemiBold"
                    CharacterSpacing="20"
                    Padding="14,8"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"/>

            <Button Content="ARCHIVIO"
                    Click="BtnArchivio_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource OroSW}"
                    FontWeight="SemiBold"
                    CharacterSpacing="20"
                    Padding="14,8"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- CENTRO: Barra di ricerca + Filtro Categoria (ComboBox) -->
        <Border Grid.Column="1"
                MaxWidth="640"
                Height="44"
                Margin="24,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{StaticResource VetroTile}"
                BorderBrush="{StaticResource OroSWBordo}"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="FiltroRicerca"
                          Grid.Column="0"
                          SelectedIndex="0"
                          MinWidth="140"
                          Padding="18,0,8,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          SelectionChanged="FiltroRicerca_SelectionChanged">
                    <ComboBoxItem Content="Tutto"/>
                    <ComboBoxItem Content="Film"/>
                    <ComboBoxItem Content="Personaggi"/>
                    <ComboBoxItem Content="Pianeti"/>
                    <ComboBoxItem Content="Razze"/>
                    <ComboBoxItem Content="Astronavi"/>
                </ComboBox>

                <Rectangle Grid.Column="1"
                           Width="1" Height="24"
                           Fill="{StaticResource OroSWBordo}"/>

                <AutoSuggestBox x:Name="CampoRicerca"
                                Grid.Column="2"
                                PlaceholderText="Cerca..."
                                QueryIcon="Find"
                                Foreground="White"
                                VerticalAlignment="Center"
                                Margin="4,0,8,0"
                                GotFocus="CampoRicerca_GotFocus"
                                TextChanged="CampoRicerca_TextChanged"
                                QuerySubmitted="CampoRicerca_QuerySubmitted">
                    <AutoSuggestBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                    </AutoSuggestBox.Resources>
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:RisultatoRicerca">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Nome}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Tipo}"
                                           Foreground="{StaticResource OroSW}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>
        </Border>

        <!-- DESTRA: Area Utente (Nome Loggato, Icona Profilo, Tasto Logout) -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

            <TextBlock x:Name="TxtNomeUtente"
                       Foreground="{StaticResource OroSW}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Visibility="Collapsed"/>

            <Button x:Name="ProfiloButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Click="BtnLogin_Click"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Profilo / Login">
                <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{StaticResource OroSW}"/>
            </Button>

            <Button x:Name="BtnLogout"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="44" Height="44"
                    CornerRadius="22"
                    Margin="8,0,0,0"
                    Click="BtnLogout_Click"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Disconnetti">
                <FontIcon Glyph="&#xF3B1;" FontSize="20" Foreground="{StaticResource RossoLogout}"/>
            </Button>
        </StackPanel>

        <!-- Linea di separazione sotto la barra -->
        <Rectangle Grid.ColumnSpan="3"
                   Height="1"
                   VerticalAlignment="Bottom"
                   Fill="{StaticResource OroSWTenue}"/>
    </Grid>
</UserControl>