<Page
    x:Class="ProgettoUSF12.PaginaDettaglio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12"
    xmlns:frontend="using:ProgettoUSF12.FrontEnd"
    xmlns:imaging="using:Windows.UI.Xaml.Media.Imaging"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#80FFE81F"/>
        <AcrylicBrush x:Key="VetroPannello" BackgroundSource="Backdrop" TintColor="#050505" TintOpacity="0.25" FallbackColor="#141414"/>
        <AcrylicBrush x:Key="VetroTile" BackgroundSource="Backdrop" TintColor="#050505" TintOpacity="0.20" FallbackColor="#1F1F1F"/>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/sfondoHome.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <frontend:BarraSuperiore Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="32,24,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Personaggio / Pianeta / Razza / Astronave (impostato nel code-behind) -->
            <TextBlock x:Name="Titolo"
                       Grid.Column="0"
                       FontSize="44" FontWeight="Black" CharacterSpacing="40"
                       Foreground="{StaticResource OroSW}"/>

            <Button Grid.Column="1"
                    Content="←  Indietro"
                    Click="Indietro_Click"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource OroSW}"
                    Background="{StaticResource VetroTile}"
                    BorderBrush="{StaticResource OroSWTenue}"
                    Padding="16,8"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="32,0,32,24"
                Background="{StaticResource VetroPannello}"
                BorderBrush="{StaticResource OroSWTenue}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="20">
            <Grid>
                <!-- Scheda singola: foto principale a sinistra, dati a destra, altre foto sotto -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,28,0" VerticalAlignment="Top">
                            <Border Width="320" Height="440"
                                    Background="#141414" CornerRadius="16" Padding="4"
                                    BorderBrush="{StaticResource OroSWTenue}" BorderThickness="1">
                                <Grid>
                                    <!-- Visibile solo se non c'è nessuna immagine -->
                                    <TextBlock x:Name="NessunaImmagine"
                                               Text="Nessuna immagine" Foreground="#606060" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Foto principale, intera -->
                                    <Image x:Name="ImgPrincipale" Stretch="Uniform"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" MinWidth="320" MaxWidth="900" VerticalAlignment="Top">
                            <TextBlock x:Name="NomeScheda"
                                       Foreground="{StaticResource OroSW}"
                                       FontSize="40" FontWeight="Bold" TextWrapping="Wrap"/>
                            <Rectangle Width="72" Height="3" RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource OroSW}"
                                       HorizontalAlignment="Left" Margin="0,8,0,20"/>

                            <!-- Info come "tessere": etichetta piccola + valore -->
                            <GridView x:Name="ListaInfo"
                                      SelectionMode="None" IsItemClickEnabled="False"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      Margin="-4,0,0,8">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="0,0,12,12"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Setter Property="IsTabStop" Value="False"/>
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RigaInfo">
                                        <Border Width="200" MinHeight="64"
                                                Background="#22FFFFFF"
                                                BorderBrush="#33FFE81F" BorderThickness="1"
                                                CornerRadius="12" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Etichetta}"
                                                           Foreground="#B0B0B0"
                                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Valore}"
                                                           Foreground="White"
                                                           FontSize="18" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <!-- Nomi cliccabili (pianeta, razza, astronavi, film...) -->
                            <ItemsControl x:Name="ListaCollegamenti" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:GruppoLink">
                                        <Border BorderBrush="{StaticResource OroSWTenue}"
                                                BorderThickness="2,0,0,0"
                                                Padding="14,2,0,2" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Intestazione}"
                                                           Foreground="{StaticResource OroSW}"
                                                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="40"
                                                           Margin="0,0,0,6"/>
                                                <RichTextBlock local:NomiCliccabili.Voci="{x:Bind Voci}"
                                                               Foreground="White" FontSize="17" LineHeight="28"
                                                               IsTextSelectionEnabled="False"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Altre foto: ognuna intera (anche quelle orizzontali), sotto a tutte le info -->
                        <StackPanel x:Name="SezioneGalleria"
                                    Grid.Row="1" Grid.ColumnSpan="2"
                                    Margin="0,20,0,72" Visibility="Collapsed">
                            <Border BorderBrush="{StaticResource OroSWTenue}" BorderThickness="2,0,0,0"
                                    Padding="14,2,0,2" Margin="0,0,0,10">
                                <TextBlock x:Name="TitoloGalleria"
                                           Foreground="{StaticResource OroSW}"
                                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="40"/>
                            </Border>
                            <GridView x:Name="GalleriaFoto"
                                      SelectionMode="None" IsItemClickEnabled="False"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      Margin="-4,0,0,0">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="0,0,14,14"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Setter Property="IsTabStop" Value="False"/>
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="imaging:BitmapImage">
                                        <Border Width="380" Height="250"
                                                Background="#101010" CornerRadius="14" Padding="6"
                                                BorderBrush="#33FFE81F" BorderThickness="1">
                                            <Image Source="{x:Bind}" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Salva / rimuovi dai salvati dell'utente loggato: in basso a destra del pannello -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock x:Name="StatoSalvataggio"
                               Foreground="#B0B0B0" FontSize="13"
                               TextWrapping="Wrap" MaxWidth="320"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnSalva"
                            Content="Salva in locale"
                            Click="BtnSalva_Click"
                            Visibility="Collapsed"
                            Foreground="{StaticResource OroSW}"
                            Background="{StaticResource VetroTile}"
                            BorderBrush="{StaticResource OroSWTenue}"
                            Padding="16,8"/>
                </StackPanel>

                <ProgressRing x:Name="Caricamento" Width="64" Height="64" IsActive="False"
                              Foreground="{StaticResource OroSW}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
