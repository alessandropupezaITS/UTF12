<Page
    x:Class="ProgettoUSF12.PaginaDettaglio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12"
    xmlns:frontend="using:ProgettoUSF12.FrontEnd"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#80FFE81F"/>
        <AcrylicBrush x:Key="VetroPannello" BackgroundSource="Backdrop" TintColor="#050505" TintOpacity="0.25" FallbackColor="#141414"/>
        <AcrylicBrush x:Key="VetroTile" BackgroundSource="Backdrop" TintColor="#050505" TintOpacity="0.20" FallbackColor="#1F1F1F"/>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/sfondoHome.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <frontend:BarraSuperiore Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="32,24,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Personaggio / Pianeta / Razza / Astronave (impostato nel code-behind) -->
            <TextBlock x:Name="Titolo"
                       Grid.Column="0"
                       FontSize="44" FontWeight="Black" CharacterSpacing="40"
                       Foreground="{StaticResource OroSW}"/>

            <Button Grid.Column="1"
                    Content="←  Indietro"
                    Click="Indietro_Click"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource OroSW}"
                    Background="{StaticResource VetroTile}"
                    BorderBrush="{StaticResource OroSWTenue}"
                    Padding="16,8"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="32,0,32,24"
                Background="{StaticResource VetroPannello}"
                BorderBrush="{StaticResource OroSWTenue}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="20">
            <Grid>
                <!-- Scheda singola: immagine grande a sinistra, dati a destra -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="320" Height="440"
                                    Background="#141414" CornerRadius="12"
                                    VerticalAlignment="Top" Margin="0,0,28,0">
                                <Grid>
                                    <TextBlock Text="Nessuna immagine" Foreground="#606060" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ImmagineScheda" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" MinWidth="280" VerticalAlignment="Top">
                                <TextBlock x:Name="NomeScheda"
                                           Foreground="{StaticResource OroSW}"
                                           FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="Riga1" Foreground="White" FontSize="18" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                <TextBlock x:Name="Riga2" Foreground="White" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="Riga3" Foreground="White" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="Galleria" Foreground="#B0B0B0" FontSize="14" Margin="0,20,0,0"/>
                            </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ProgressRing x:Name="Caricamento" Width="64" Height="64" IsActive="False"
                              Foreground="{StaticResource OroSW}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
