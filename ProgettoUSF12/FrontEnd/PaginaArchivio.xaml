<Page
    x:Class="ProgettoUSF12.PaginaArchivio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12"
    xmlns:frontend="using:ProgettoUSF12.FrontEnd"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#80FFE81F"/>
        <AcrylicBrush x:Key="VetroPannello" BackgroundSource="Backdrop" TintColor="#050505" TintOpacity="0.25" FallbackColor="#141414"/>
        <AcrylicBrush x:Key="VetroTile" BackgroundSource="Backdrop" TintColor="#050505" TintOpacity="0.20" FallbackColor="#1F1F1F"/>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/sfondoHome.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <frontend:BarraSuperiore Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="32,24,0,16">
            <TextBlock Text="ARCHIVIO"
                       FontSize="44"
                       FontWeight="Black"
                       CharacterSpacing="40"
                       Foreground="{StaticResource OroSW}"/>
            <Rectangle Width="72" Height="3" RadiusX="2" RadiusY="2"
                       Fill="{StaticResource OroSW}"
                       HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="32,0,32,24"
                Background="{StaticResource VetroPannello}"
                BorderBrush="{StaticResource OroSWTenue}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filtro: stesse categorie della barra di ricerca -->
                <ListView x:Name="ListaFiltri"
                          Grid.Row="0"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ListaFiltri_ItemClick"
                          Background="Transparent"
                          Margin="0,0,0,8"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{StaticResource VetroTile}"
                                    BorderBrush="{StaticResource OroSWTenue}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,8"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{x:Bind}" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Filtro attivo + numero di elementi -->
                <TextBlock x:Name="Conteggio"
                           Grid.Row="1"
                           Foreground="#B0B0B0"
                           FontSize="13"
                           Margin="2,0,0,12"/>

                <!-- Solo immagine + nome. Le immagini si scaricano solo per le schede
                     che entrano nella vista (vedi ContainerContentChanging). -->
                <GridView x:Name="Griglia"
                          Grid.Row="2"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="Griglia_ItemClick"
                          ContainerContentChanging="Griglia_ContainerContentChanging"
                          SizeChanged="Griglia_SizeChanged"
                          Background="Transparent">
                    <!-- Le schede si allargano per riempire la riga (niente vuoto a destra):
                         la larghezza della cella la imposta Griglia_SizeChanged. -->
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:VoceArchivio">
                            <StackPanel Margin="0,0,16,16">
                                <!-- Immagine intera (Uniform) su sfondo scuro: niente ritagli strani e meno ingrandimenti
                                     delle foto piccole, quindi più nitide. -->
                                <Border Height="210"
                                        CornerRadius="14"
                                        Padding="6"
                                        Background="#101010"
                                        BorderBrush="#33FFE81F" BorderThickness="1">
                                    <Image Source="{x:Bind Miniatura, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{x:Bind Nome}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,8,2,0"/>
                                <TextBlock Text="{x:Bind Tipo}"
                                           Foreground="{StaticResource OroSW}"
                                           FontSize="11"
                                           Margin="2,2,2,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock x:Name="Vuoto"
                           Grid.Row="2"
                           Text="Nessun elemento (controlla la connessione)"
                           Foreground="#B0B0B0"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <ProgressRing x:Name="Caricamento"
                              Grid.Row="2"
                              Width="64" Height="64"
                              IsActive="False"
                              Foreground="{StaticResource OroSW}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
