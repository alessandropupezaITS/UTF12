<Page
    x:Class="ProgettoUSF12.PaginaFilm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProgettoUSF12"
    xmlns:frontend="using:ProgettoUSF12.FrontEnd"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="OroSW" Color="#FFE81F"/>
        <SolidColorBrush x:Key="OroSWTenue" Color="#80FFE81F"/>

        <AcrylicBrush x:Key="VetroPannello"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.25"
                      FallbackColor="#141414"/>

        <AcrylicBrush x:Key="VetroTile"
                      BackgroundSource="Backdrop"
                      TintColor="#050505"
                      TintOpacity="0.20"
                      FallbackColor="#1F1F1F"/>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/sfondoHome.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <frontend:BarraSuperiore Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="32,24,0,16">
            <TextBlock Text="FILM"
                       FontSize="44"
                       FontWeight="Black"
                       CharacterSpacing="40"
                       Foreground="{StaticResource OroSW}"/>
            <Rectangle Width="72" Height="3" RadiusX="2" RadiusY="2"
                       Fill="{StaticResource OroSW}"
                       HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="32,0,32,24"
                Background="{StaticResource VetroPannello}"
                BorderBrush="{StaticResource OroSWTenue}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Chip: "Tutti" + uno per ogni film. Il click filtra sul posto. -->
                <ListView x:Name="ListaCategorie"
                          Grid.Row="0"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ListaCategorie_ItemClick"
                          Background="Transparent"
                          Margin="0,0,0,16"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{StaticResource VetroTile}"
                                    BorderBrush="{StaticResource OroSWTenue}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,8"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{x:Bind}"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Un blocco per film: locandina + info + elenco dei nomi (solo testo).
                     Niente riquadro interno: il contenuto sta direttamente sul pannello,
                     una linea sottile separa un film dall'altro. -->
                <ListView x:Name="ListaFilm"
                          Grid.Row="1"
                          SelectionMode="None"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SchedaFilm">
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0"
                                        Width="180" Height="270"
                                        CornerRadius="16"
                                        Background="#141414"
                                        BorderBrush="{StaticResource OroSWTenue}" BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Margin="0,0,24,0">
                                    <Image Source="{x:Bind local:PaginaFilm.ConvertiPoster(Film.PosterUrl)}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="{x:Bind Film.Title}"
                                               Foreground="{StaticResource OroSW}"
                                               FontSize="32" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <Rectangle Width="72" Height="3" RadiusX="2" RadiusY="2"
                                               Fill="{StaticResource OroSW}"
                                               HorizontalAlignment="Left" Margin="0,6,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="150" Background="#22FFFFFF"
                                                BorderBrush="#33FFE81F" BorderThickness="1"
                                                CornerRadius="10" Padding="12,6" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="EPISODIO" Foreground="#B0B0B0"
                                                           FontSize="10" FontWeight="SemiBold" CharacterSpacing="40"/>
                                                <TextBlock Text="{x:Bind Film.EpisodeId}" Foreground="White"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border MinWidth="150" Background="#22FFFFFF"
                                                BorderBrush="#33FFE81F" BorderThickness="1"
                                                CornerRadius="10" Padding="12,6" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="REGIA" Foreground="#B0B0B0"
                                                           FontSize="10" FontWeight="SemiBold" CharacterSpacing="40"/>
                                                <TextBlock Text="{x:Bind Film.Director}" Foreground="White"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="150" Background="#22FFFFFF"
                                                BorderBrush="#33FFE81F" BorderThickness="1"
                                                CornerRadius="10" Padding="12,6" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="USCITA" Foreground="#B0B0B0"
                                                           FontSize="10" FontWeight="SemiBold" CharacterSpacing="40"/>
                                                <TextBlock Text="{x:Bind Film.ReleaseDate}" Foreground="White"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Introduzione intera, con le righe unite per paragrafo -->
                                    <Border BorderBrush="{StaticResource OroSWTenue}"
                                            BorderThickness="2,0,0,0"
                                            Padding="12,0,0,0" Margin="0,0,16,12">
                                        <StackPanel>
                                            <TextBlock Text="INTRODUZIONE"
                                                       Foreground="{StaticResource OroSW}"
                                                       FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                       Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{x:Bind Paragrafi}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{x:Bind}"
                                                                   Foreground="White" FontSize="14" LineHeight="22"
                                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                BorderBrush="{StaticResource OroSWTenue}"
                                                BorderThickness="2,0,0,0"
                                                Padding="12,0,0,0" Margin="0,0,16,12">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind TitoloPersonaggi}"
                                                           Foreground="{StaticResource OroSW}"
                                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                           Margin="0,0,0,4"/>
                                                <RichTextBlock local:NomiCliccabili.Voci="{x:Bind Personaggi}"
                                                               Foreground="White" FontSize="14" LineHeight="22"
                                                               IsTextSelectionEnabled="False"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0"
                                                BorderBrush="{StaticResource OroSWTenue}"
                                                BorderThickness="2,0,0,0"
                                                Padding="12,0,0,0" Margin="0,0,16,12">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind TitoloPianeti}"
                                                           Foreground="{StaticResource OroSW}"
                                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                           Margin="0,0,0,4"/>
                                                <RichTextBlock local:NomiCliccabili.Voci="{x:Bind Pianeti}"
                                                               Foreground="White" FontSize="14" LineHeight="22"
                                                               IsTextSelectionEnabled="False"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1"
                                                BorderBrush="{StaticResource OroSWTenue}"
                                                BorderThickness="2,0,0,0"
                                                Padding="12,0,0,0" Margin="0,0,16,12">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind TitoloRazze}"
                                                           Foreground="{StaticResource OroSW}"
                                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                           Margin="0,0,0,4"/>
                                                <RichTextBlock local:NomiCliccabili.Voci="{x:Bind Razze}"
                                                               Foreground="White" FontSize="14" LineHeight="22"
                                                               IsTextSelectionEnabled="False"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2"
                                                BorderBrush="{StaticResource OroSWTenue}"
                                                BorderThickness="2,0,0,0"
                                                Padding="12,0,0,0" Margin="0,0,16,12">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind TitoloAstronavi}"
                                                           Foreground="{StaticResource OroSW}"
                                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                           Margin="0,0,0,4"/>
                                                <RichTextBlock local:NomiCliccabili.Voci="{x:Bind Astronavi}"
                                                               Foreground="White" FontSize="14" LineHeight="22"
                                                               IsTextSelectionEnabled="False"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Button Content="{x:Bind TestoSalva, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="BtnSalvaFilm_Click"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,0,0"
                                            Foreground="{StaticResource OroSW}"
                                            Background="{StaticResource VetroTile}"
                                            BorderBrush="{StaticResource OroSWTenue}"
                                            Padding="16,6"/>
                                </StackPanel>

                                <Rectangle Grid.Row="1" Grid.ColumnSpan="2"
                                           Height="1"
                                           Fill="{StaticResource OroSWTenue}"
                                           Margin="0,16,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="Caricamento"
                              Grid.Row="1"
                              Width="64" Height="64"
                              IsActive="False"
                              Foreground="{StaticResource OroSW}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
